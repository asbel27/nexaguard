{
  "name": "nexaguard-social-autoposter",
  "version": "1.0.0",
  "description": "Desktop Automation Suite for Facebook Groups & Instagram posting for NexaGuard",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js --open",
    "build:exe": "npx @yao-pkg/pkg . --targets node20-win-x64 --output NexaGuard-Social-AutoPoster.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "engine/**/*",
      "data/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ]
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "puppeteer-core": "^24.4.0"
  },
  "author": "NexaGuard Security",
  "license": "ISC"
}
